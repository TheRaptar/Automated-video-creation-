# =============================================================================
# RAPTAR: Autonomous AI Video Creation & Social Media Automation System
# Configuration Template (.env.example)
# Note: Never commit actual keys or tokens to git.
# =============================================================================

# --- AI Intelligence (Required for Agent Planning, Animation SVG & Localization) ---
# Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-4-hydrogen"

# Optional secondary fallback LLM (Groq)
GROQ_API_KEY=""

# --- Stock Footage Video Providers ---
# Pixabay API Key (Free registration at https://pixabay.com/api/docs/)
PIXABAY_API_KEY=""

# Pexels API Key (Optional secondary stock video provider)
PEXELS_API_KEY=""

# --- YouTube Data API v3 (OAuth2 Credentials) ---
# Google Cloud Console OAuth 2.0 Client credentials
YT_CLIENT_ID=""
YT_CLIENT_SECRET=""
YT_REFRESH_TOKEN=""
# Video privacy status: "public" | "unlisted" | "private" (default: "public")
YT_PRIVACY="public"
# YouTube category id (24 = Entertainment / Animation, 27 = Education)
YT_CATEGORY="24"
# Max daily YouTube uploads limit (default: 5)
MAX_UPLOADS_PER_DAY="10"

# --- Instagram Graph API (Meta Unified Login) ---
# Long-lived User/Page Access Token with instagram_content_publish scope
IG_ACCESS_TOKEN=""
# Optional Instagram Business Account ID (auto-discovered if left blank)
IG_USER_ID=""
# Max daily Instagram Reels limit (default: 4)
MAX_IG_POSTS_PER_DAY="10"

# --- Cloudinary (Temporary Video Staging for Instagram Container Uploads) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Production Tuning, Animation & Multilingual Settings ---
# Edge-TTS Default Neural Voice (auto-overridden per language when TARGET_LANGUAGE != en)
TTS_VOICE="en-US-GuyNeural"

# Primary language: "auto" (rotates global languages) | en | ta | hi | es | fr | pt | de | ja | ko | ar | id
TARGET_LANGUAGE="en"

# Optional comma-separated additional dubs produced per run (e.g. "ta,hi,es")
DUB_LANGUAGES=""

# AI Animation mode: "auto" (animated for animated/story genres) | "always" | "never"
ANIMATED_MODE="auto"

# Target duration ranges (seconds)
VIDEO_SECONDS="40-60"
LONG_SECONDS="300-420"

# Target format for default runs: "animated" | "short" | "story" | "long"
VIDEO_FORMAT="animated"

# Trend research enable flag ("1" = enabled, "0" = disabled)
TRENDS="1"

# Font file path (leave blank for automatic language-aware Noto font selection)
FONT_PATH=""

# Host port for headless automation server
PORT=3000

