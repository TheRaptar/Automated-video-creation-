# =============================================================================
# RAPTAR: Autonomous AI Video Creation & Social Media Automation System
# Configuration Template (.env.example)
# Note: Never commit actual keys or tokens to git.
# =============================================================================

# --- AI Intelligence (Required for Agent Planning & Scriptwriting) ---
# Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=""

# Optional secondary fallback LLM (Groq)
GROQ_API_KEY=""

# --- Stock Footage Video Providers ---
# Pixabay API Key (Free registration at https://pixabay.com/api/docs/)
PIXABAY_API_KEY=""

# Pexels API Key (Optional secondary stock video provider)
PEXELS_API_KEY=""

# --- YouTube Data API v3 (OAuth2 Credentials) ---
# Google Cloud Console OAuth 2.0 Client credentials
YT_CLIENT_ID=""
YT_CLIENT_SECRET=""
YT_REFRESH_TOKEN=""
# Video privacy status: "public" | "unlisted" | "private" (default: "public")
YT_PRIVACY="public"
# YouTube category id (27 = Education)
YT_CATEGORY="27"
# Max daily YouTube uploads limit (default: 5)
MAX_UPLOADS_PER_DAY="5"

# --- Instagram Graph API (Meta Unified Login) ---
# Long-lived User/Page Access Token with instagram_content_publish scope
IG_ACCESS_TOKEN=""
# Optional Instagram Business Account ID (auto-discovered if left blank)
IG_USER_ID=""
# Max daily Instagram Reels limit (default: 4)
MAX_IG_POSTS_PER_DAY="4"

# --- Cloudinary (Temporary Video Staging for Instagram Container Uploads) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Production Tuning & Voice Settings ---
# Edge-TTS Neural Voice:
# Options: "en-US-GuyNeural", "en-US-JennyNeural", "en-GB-RyanNeural", "en-IN-PrabhatNeural"
TTS_VOICE="en-US-GuyNeural"

# Target duration ranges (seconds)
VIDEO_SECONDS="40-60"
LONG_SECONDS="300-420"

# Target format for default runs: "short" | "story" | "long"
VIDEO_FORMAT="short"

# Trend research enable flag ("1" = enabled, "0" = disabled)
TRENDS="1"

# Font file path (leave blank for automatic system detection)
FONT_PATH=""

# Host port for dashboard web server
PORT=3000

